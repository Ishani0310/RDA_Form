# ==============================================================================
# Road Development Authority (RDA) - Contractor Data Collection System
# Environment Configuration Template
# NOTE: Do not commit actual credentials or connection strings to version control.
# ==============================================================================

# MongoDB Atlas Connection String
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/rda_contractor_db?retryWrites=true&w=majority
MONGODB_URI=

# Authentication Secret (Minimum 32 characters for HS256 JWT session signing)
AUTH_SECRET=

# Active Email Dispatcher Provider ("gmail" | "resend" | "smtp" - defaults to auto-detect)
EMAIL_PROVIDER=

# ------------------------------------------------------------------------------
# Google Gmail API (OAuth 2.0) Configuration
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_REFRESH_TOKEN=
GOOGLE_SENDER_EMAIL=

# ------------------------------------------------------------------------------
# Resend API (Alternative Provider)
# ------------------------------------------------------------------------------
RESEND_API_KEY=
RESEND_FROM=
RESEND_TEST_RECIPIENT=

# ------------------------------------------------------------------------------
# SMTP Configuration (Fallback Provider)
# ------------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
